    constexpr auto vkMakeVersion(unsigned major, unsigned minor, unsigned patch) { return (major << 22U) | (minor << 12U) | patch; }
    constexpr auto vkMakeAPIVersion(unsigned variant, unsigned major, unsigned minor, unsigned patch)
    {
        return (variant << 29U) | (major << 22U) | (minor << 12U) | patch;
    }
